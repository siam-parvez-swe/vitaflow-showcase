# VitaFlow showcase runs in local demo mode by default.
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_BASE_URL=http://localhost:5000

# Server-only values. Never prefix these with NEXT_PUBLIC_.
# Add these only to a trusted server environment when connecting your backend.
MONGO_DB_URI=your_mongodb_connection_string
BETTER_AUTH_SECRET=generate_a_new_random_secret
BETTER_AUTH_URL=http://localhost:3000
NEXT_APP_URL=http://localhost:3000
PORT=5000

# Optional integrations (not required for the local showcase demo)
NEXT_PUBLIC_IMGBB_API_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
JWT_SECRET=generate_a_new_jwt_secret
INTERNAL_API_SECRET=generate_a_new_internal_secret
